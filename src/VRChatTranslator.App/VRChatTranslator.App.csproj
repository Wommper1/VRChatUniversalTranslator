<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VRChatTranslator.App</RootNamespace>
    <AssemblyName>VRChatUniversalTranslator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <AssemblyTitle>VRChat Universal Translator</AssemblyTitle>
    <Description>Live captions and English translation of VRChat audio, running entirely on your PC.</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VRChatTranslator.Audio\VRChatTranslator.Audio.csproj" />
    <ProjectReference Include="..\VRChatTranslator.Core\VRChatTranslator.Core.csproj" />
    <ProjectReference Include="..\VRChatTranslator.Speech\VRChatTranslator.Speech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\VRChatTranslator.Speech\Workers\translate.py" Link="tools\translate.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty\OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty\OpenVR\LICENSE" Link="licenses\OpenVR.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty\Licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\setup-translation.ps1" Link="tools\setup-translation.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\requirements-translation.txt" Link="tools\requirements-translation.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
