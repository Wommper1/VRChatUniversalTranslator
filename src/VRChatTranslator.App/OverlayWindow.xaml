<Window x:Class="VRChatTranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caption Overlay"
        Width="920"
        Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Grid MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border x:Name="CaptionPanel"
            Margin="10"
            Padding="24,18"
            Background="#E5111722"
            BorderBrush="#5566D6C5"
            BorderThickness="1"
            CornerRadius="18"
            Opacity="0">
      <ScrollViewer x:Name="CaptionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock x:Name="LanguageText"
                   Foreground="#FF66D6C5"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="14"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="CaptionText"
                   Margin="0,7,0,0"
                   Foreground="#FFF3F6FB"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="32"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
        <TextBlock x:Name="OriginalText" Margin="0,8,0,0" Foreground="#FFB9C5D8" FontSize="23" TextWrapping="Wrap" TextAlignment="Center" />
        <TextBlock x:Name="InteractionHint"
                   Margin="0,9,0,0"
                   Foreground="#FF99A4B7"
                   FontSize="11"
                   Text="Overlay unlocked · drag anywhere · Ctrl+Alt+O locks and enables click-through"
                   TextAlignment="Center"
                   Visibility="Collapsed" />
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
</Window>
