<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>The Level Everything Company</Company>
    <Authors>The Level Everything Company</Authors>
    <Product>VRChat Universal Translator</Product>
    <Copyright>Copyright (c) 2026 The Level Everything Company</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
